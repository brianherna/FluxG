# ==============================================================================
# FLUXGUARD - PLANTILLA DE CONFIGURACIÓN (.env.example)
# ==============================================================================
# Copia este archivo como '.env' en tu máquina local y coloca tus credenciales reales.
# El archivo '.env' real NO se subirá a GitHub (.gitignore).
# ==============================================================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxxxx.mongodb.net/fluxg?retryWrites=true&w=majority
MONGODB_DATABASE=fluxg

# Servidor
SERVER_PORT=8080

# GitHub
GITHUB_USERNAME=brianherna
GITHUB_REPO=brianherna/FluxG
GITHUB_TOKEN=ghp_tu_token_aqui
